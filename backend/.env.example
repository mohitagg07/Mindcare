# Supabase → Project Settings → API. Use the project URL and publishable/anon key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# GroqCloud API key (server-side only; never expose in VITE_* variables)
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# API security / frontend URLs
ALLOWED_ORIGINS=https://mindcare-opal.vercel.app,http://localhost:5173
FRONTEND_URL=https://mindcare-opal.vercel.app
LOG_LEVEL=INFO

